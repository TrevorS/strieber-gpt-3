# =============================================================================
# Authelia Secrets - EXAMPLE FILE
# =============================================================================
# Copy this to .env.authelia and replace with real values:
#   cp .env.authelia.example .env.authelia
#
# Generate secrets with:
#   openssl rand -base64 48

# Session secret (minimum 64 characters)
AUTHELIA_SESSION_SECRET=REPLACE_WITH_RANDOM_STRING_64_CHARS_MINIMUM

# Storage encryption key (minimum 20 characters)
AUTHELIA_STORAGE_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_STRING_20_CHARS_MINIMUM

# JWT secret for identity validation (minimum 32 characters)
AUTHELIA_JWT_SECRET=REPLACE_WITH_RANDOM_STRING_32_CHARS_MINIMUM
