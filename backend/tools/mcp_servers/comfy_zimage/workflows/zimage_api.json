{
  "_comment": "z-image turbo text-to-image workflow (API format)",
  "_instructions": "Uses UNETLoader, CLIPLoader (lumina2), VAELoader, ModelSamplingAuraFlow. Optimized for 9 steps with res_multistep sampler.",
  "_node_mapping": {
    "clip_loader": "Node ID 1 - CLIPLoader for text encoder (qwen_3_4b, lumina2 type)",
    "vae_loader": "Node ID 2 - VAELoader for VAE decoder (ae.safetensors)",
    "unet_loader": "Node ID 3 - UNETLoader for diffusion model (z_image_turbo_bf16)",
    "empty_latent": "Node ID 4 - EmptySD3LatentImage (width, height, batch_size)",
    "positive_prompt": "Node ID 5 - CLIPTextEncode for positive prompt",
    "negative_zero": "Node ID 6 - ConditioningZeroOut for negative conditioning",
    "model_sampling": "Node ID 7 - ModelSamplingAuraFlow (shift=3)",
    "sampler": "Node ID 8 - KSampler (seed, steps=9, cfg=1, res_multistep, simple)",
    "vae_decode": "Node ID 9 - VAEDecode",
    "save_image": "Node ID 10 - SaveImage"
  },
  "1": {
    "inputs": {
      "clip_name": "qwen_3_4b.safetensors",
      "type": "lumina2",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Load CLIP (qwen_3_4b lumina2)"
    }
  },
  "2": {
    "inputs": {
      "vae_name": "ae.safetensors"
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "Load VAE"
    }
  },
  "3": {
    "inputs": {
      "unet_name": "z_image_turbo_bf16.safetensors",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Load Diffusion Model (z-image turbo)"
    }
  },
  "4": {
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    },
    "class_type": "EmptySD3LatentImage",
    "_meta": {
      "title": "Empty SD3 Latent Image"
    }
  },
  "5": {
    "inputs": {
      "text": "PLACEHOLDER_POSITIVE_PROMPT",
      "clip": [
        "1",
        0
      ]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "CLIP Text Encode (Positive)"
    }
  },
  "6": {
    "inputs": {
      "conditioning": [
        "5",
        0
      ]
    },
    "class_type": "ConditioningZeroOut",
    "_meta": {
      "title": "Conditioning Zero Out (Negative)"
    }
  },
  "7": {
    "inputs": {
      "model": [
        "3",
        0
      ],
      "shift": 3.0
    },
    "class_type": "ModelSamplingAuraFlow",
    "_meta": {
      "title": "Model Sampling AuraFlow (shift=3)"
    }
  },
  "8": {
    "inputs": {
      "seed": 0,
      "steps": 9,
      "cfg": 1.0,
      "sampler_name": "res_multistep",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": [
        "7",
        0
      ],
      "positive": [
        "5",
        0
      ],
      "negative": [
        "6",
        0
      ],
      "latent_image": [
        "4",
        0
      ]
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "KSampler (res_multistep)"
    }
  },
  "9": {
    "inputs": {
      "samples": [
        "8",
        0
      ],
      "vae": [
        "2",
        0
      ]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode"
    }
  },
  "10": {
    "inputs": {
      "filename_prefix": "zimage",
      "images": [
        "9",
        0
      ]
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save Image"
    }
  }
}
